# Portable preferences. Credentials and machine-specific integrations stay local.
model = "gpt-6.1-sol"
model_reasoning_effort = "xhigh"
service_tier = "default"
plan_mode_reasoning_effort = "xhigh"
sandbox_mode = "danger-full-access"
approval_policy = "never"
approvals_reviewer = "user"

[notice]
hide_full_access_warning = true
hide_rate_limit_model_nudge = true

[tui]
theme = "monokai-extended-bright"
status_line = ["model-with-reasoning", "project-name", "context-remaining", "context-used", "five-hour-limit", "weekly-limit", "context-window-size", "git-branch"]
status_line_use_colors = true

[features]
terminal_resize_reflow = true
memories = true
prevent_idle_sleep = true

[plugins."github@openai-curated"]
enabled = true

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[shell_environment_policy]
inherit = "core"
