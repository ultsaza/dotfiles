export ZSH_DISABLE_COMPFIX=true
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export ZSH_AI_PROVIDER=ollama

{{ if eq .chezmoi.os "darwin" -}}
typeset -U fpath
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  for completion_dir in "$HOMEBREW_PREFIX/share/zsh/site-functions" "$HOMEBREW_PREFIX/share/zsh-completions" "$HOME/.local/share/zsh/site-functions"; do
    [[ -d "$completion_dir" ]] && fpath=("$completion_dir" $fpath)
  done
  unset completion_dir
fi
export PNPM_HOME="$HOME/Library/pnpm"
if [[ -x /usr/libexec/java_home ]]; then
  JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null) && export JAVA_HOME
fi
{{ else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end -}}
path=("$PNPM_HOME" $path)

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load only plugins that have actually been installed.
plugins=(git)
for plugin in zsh-autosuggestions zsh-256color zsh-ai zsh-syntax-highlighting; do
  if [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$plugin" || -d "$ZSH/plugins/$plugin" ]]; then
    plugins+=($plugin)
  fi
done
ZSH_THEME=robbyrussell
[[ -r "${ZSH_CUSTOM:-$ZSH/custom}/themes/agnosterzak.zsh-theme" || -r "$ZSH/themes/agnosterzak.zsh-theme" ]] && ZSH_THEME=agnosterzak
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Oh My Zsh initializes completion; plain Zsh needs its own initialization.
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit bashcompinit
  compinit -i
  bashcompinit
fi
zmodload zsh/complist
setopt AUTO_MENU COMPLETE_IN_WORD ALWAYS_TO_END
zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'

# Keep history-based suggestions useful across sessions, also without Oh My Zsh.
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
(( HISTSIZE < 50000 )) && HISTSIZE=50000
(( SAVEHIST < 10000 )) && SAVEHIST=10000
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_VERIFY SHARE_HISTORY
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[comment]='fg=244'

if [[ -r "$HOME/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$HOME/powerlevel10k/powerlevel10k.zsh-theme"
{{ if eq .chezmoi.os "darwin" -}}
elif command -v brew >/dev/null && [[ -r "$(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme"
{{ end -}}
fi
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

if command -v lsd >/dev/null; then
  alias ls=lsd
  alias lt='ls --tree'
fi
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'

command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
export EDITOR="${EDITOR:-nvim}"

export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
{{ if eq .chezmoi.os "darwin" -}}
elif [[ -n "${HOMEBREW_PREFIX:-}" && -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]]; then
  source "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
{{ end -}}
fi
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
[[ -t 1 ]] && command -v fastfetch >/dev/null && fastfetch --show-errors

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew plugins work without Oh My Zsh; avoid loading an existing plugin twice.
if (( ! $+functions[_zsh_autosuggest_start] )) && [[ -n "${HOMEBREW_PREFIX:-}" && -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
{{ end -}}

# Machine-specific aliases, VPN endpoints and secrets stay outside Git.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

{{ if eq .chezmoi.os "darwin" -}}
# Syntax highlighting must load after plugins and local widget definitions.
if (( ! $+functions[_zsh_highlight] )) && [[ -n "${HOMEBREW_PREFIX:-}" && -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{ end -}}
# Successful startup must not depend on the optional local file existing.
true
