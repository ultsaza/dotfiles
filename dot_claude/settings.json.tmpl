{
  "agentPushNotifEnabled": true,
  "editorMode": "normal",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": true,
    "nvidia-kaggle@nvidia-kaggle": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "nvidia-kaggle": {
      "source": {
        "source": "git",
        "url": "https://github.com/NVIDIA/nvidia-kaggle.git"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "tui": "fullscreen",
  "verbose": true,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "voiceEnabled": false,
  "worktree": {
    "baseRef": "fresh"
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-fable-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1m]",
    "ANTHROPIC_MODEL": "opusplan",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "statusLine": {
    "type": "command",
    "command": {{ printf "bash %q" (joinPath .chezmoi.homeDir ".claude/statusline-command.sh") | toJson }}
  }
}
